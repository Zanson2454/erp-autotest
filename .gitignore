# 忽略静态文件
/media/*

# 忽略迁移文件
*/migrations/*

# 忽略Python编译文件
*.pyc
__pycache__/
*.pyo
*.pyd
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# 忽略IDE配置文件
.idea/
.vscode/
*.swp
*.swo

# 忽略虚拟环境
venv/
.env
.venv/
.venv_mitmproxy/  # 旧版独立 mitm 环境，可删除；录制已并入主 .venv
env/
ENV/
.recorder_index.json

# 忽略日志文件
*.log
logs/

# 忽略测试覆盖率报告
.coverage
htmlcov/
.tox/
.nox/
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/

# 忽略本地配置文件
local_settings.py
db.sqlite3
db.sqlite3-journal 
run_tests.sh

# 忽略配置数据
.env
*.env
*logs/*
.DS_Store
**/.DS_Store
specification.mdc

# 忽略 Allure 结果和报告内容，但保留目录结构
reports/allure-results/*
!reports/allure-results/.gitkeep

reports/allure-report/*
!reports/allure-report/.gitkeep

# 忽略正在调试的用例
testdata/cache/*
# SQL 源 YAML 内容 hash（改配置后失效 json 缓存用，如 .init_cache.source_hash）
testdata/cache/*source_hash
case_coverage_stat.json

# 忽略用户输入
test.mdc
docs/
reports/fin_case_coverage.json

# 忽略 Allure 结果和报告（根目录）
allure-results/
allure-report/


# 录制运行时开关状态（本地）
api_record/runtime/

# 录制产物（不作为正式回归资产）
api_record/testdata/recorded/
api_record/generated_cases/
api_record/raw_curls/
