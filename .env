portal_config:
  terp: # 租户级别
    # 默认用户配置（向后兼容）
    auth:
      username: "${TEST_USERNAME}"
      password: "${TEST_PASSWORD}"
    
    
    # 多门户配置（新增）
    TERP_PORTAL: # 门户 key
      username: "${TEST_TERP_PORTAL_USERNAME}"
      password: "${TEST_TERP_PORTAL_PASSWORD}"
      iam_referer: "${TEST_TERP_PORTAL_IAM_REFERER}"
      poartal_referer: "${TEST_TERP_PORTAL_REFERER}"
      description: "TERP门户"
      
    
    TERP_CUST_PC: # 门户 key
      username: "${TEST_TERP_CUST_PC_USERNAME}"
      password: "${TEST_TERP_CUST_PC_PASSWORD}"
      iam_referer: "${TEST_TERP_CUST_PC_IAM_REFERER}"
      poartal_referer: "${TEST_TERP_CUST_PC_REFERER}"
      description: "TERP客户端PC门户"
        
    

# 数据库配置
database:
  erp_db:
    host: ${TEST_DB_HOST}
    port: ${TEST_DB_PORT}
    user: ${TEST_DB_USER}
    password: ${TEST_DB_PASSWORD}
    database: ${TEST_DB_NAME}
    charset: utf8mb4
