# ERP自动化测试用例生成规则
[always]
# [manual]
## 使用说明
本规则用于指导ERP系统自动化测试用例的编写，确保测试代码风格一致性和可维护性。
通过在Cursor中使用@testcase-role触发此规则，可以快速生成符合规范的测试用例框架。

## 适用范围
适用于所有ERP模块的功能测试、接口测试、流程测试等自动化测试场景。

## 1. 文件结构规范

### 1.1 测试文件命名
- 使用`test_<模块>_<功能>.py`格式命名文件
- 例如：`test_po_add.py`、`test_po_query.py`

### 1.2 文件头部模板
```python
"""
<模块名称>模块测试用例
包含<主要功能点列表>等操作
"""
import sys
import time
import json
import random
import allure
import pytest
from pathlib import Path
from testcases.<领域> import <领域>BaseTest
from utils.allure_simple import a  # 导入简化的Allure辅助类
from utils.param_util import ParamUtil  # 导入参数处理工具类

# 添加项目根目录到 Python 路径
project_root = Path(__file__).resolve().parent.parent.parent
sys.path.insert(0, str(project_root))
```

### 1.3 测试类模板
```python
@allure.epic("<领域名称>")
@allure.feature("<功能模块>")
class Test<功能名称>(<领域>BaseTest):
    """<功能名称>测试类"""
    
    # 保存相关信息的类变量，所有测试用例共享
    <功能>_info = {}
    
    @classmethod
    def setup_class(cls):
        """
        测试类初始化
        1. 调用父类初始化方法
        2. 初始化日志记录器
        """
        # 调用父类的初始化方法
        super().setup_class()
        
        cls.logger.info("<功能名称>测试类初始化完成")
```

## 2. __init__.py文件规范

### 2.1 目录结构
每个测试领域目录下应包含__init__.py文件

### 2.2 BaseTest类定义
```python
"""
<领域名称>模块基础测试类
"""
from testcases.comm.base_test import BaseTest

class <领域>BaseTest(BaseTest):
    """<领域名称>模块基础测试类"""
    
    @classmethod
    def setup_class(cls):
        """
        初始化方法
        1. 调用父类初始化
        2. 加载YAML配置
        """
        # 调用BaseTest的初始化方法
        super().setup_class()
        
        # 获取API路径和参数配置
        cls.yaml_path = cls.get_yaml_path("<领域>")
        cls.yaml_params = cls.get_yaml_params("<领域>")
        
        cls.logger.info("<领域>BaseTest初始化完成")
```

## 3. 测试方法规范

### 3.1 测试方法模板
```python
@pytest.mark.run(order=<序号>)
@allure.story("<功能点>")
@allure.description("""
## 测试步骤
1. <步骤一描述>
2. <步骤二描述>
...
""")
@allure.severity(allure.severity_level.BLOCKER)
@allure.title("<测试标题>")
@allure.tag("<标签1>", "<标签2>")
def test_<功能点>(self):
    try:
        with a.step("1. <步骤一描述>"):
            # 步骤一代码
            # 例如：生成测试数据
            <测试数据生成代码>
            
            # 添加到报告中
            a.text("<测试数据描述>", "<标题>")
        
        with a.step("2. 准备请求数据"):
            # 获取API路径
            api_path = self.get_api_path("<API路径名称>")
            self.logger.debug(f"<功能点>API路径: {api_path}")
            
            # 获取请求参数和完整URL
            params, url = self.get_api_params(api_path)
            
            # 使用ParamUtil过滤字段，同时保留嵌套结构
            filtered_params = ParamUtil.filter_post_body_fields(params, 
                            ["<字段1>", "<字段2>"], ["params", "request"])
            
            # 设置必要参数值
            filtered_params['params']["request"]["<字段名>"] = <值>
            
            self.logger.info(f"请求URL: {url}")
            self.logger.info(f"请求参数: {filtered_params}")
            # 添加请求数据到报告
            a.json(filtered_params, "请求数据")
        
        with a.step("3. 发送请求"):
            # 发送请求
            result = self.http.post(url, json=filtered_params, description="<请求描述>")
            # 添加响应数据到报告
            a.json(result, "响应数据")
        
        with a.step("4. 验证响应结果"):
            # 验证响应中的success字段为True
            self.assert_util.assert_response_success(result)
            
            # 从响应中获取关键数据
            response_data = result.get("data", {}).get("data", {})
            <关键字段> = response_data.get("<字段名>")
            
            # 确保返回了有效的数据
            assert <关键字段>, "<错误信息>"
            
            # 记录验证结果
            a.text(
                f"<字段描述>: {<关键字段>}\n验证结果: 成功",
                "验证结果"
            )
        
        with a.step("5. 保存测试数据"):
            # 保存测试数据到类变量，供后续测试用例使用
            Test<功能名称>.<功能>_info.update({
                "<键1>": <值1>,
                "<键2>": <值2>
            })
            
            self.logger.info(f"<操作描述> - <关键数据描述>")
            
            # 记录保存的数据
            a.json(Test<功能名称>.<功能>_info, "保存的测试数据")
        
    except Exception as e:
        self.logger.error(f"<功能点>失败: {str(e)}")
        # 记录失败信息
        a.text(str(e), "失败原因")
        raise
```

## 4. 主函数入口规范
```python
