```
### 1.3 用例模块下的__init__.py规范
```python
import sys
from pathlib import Path

project_root = Path(__file__).resolve().parent.parent.parent
sys.path.insert(0, str(project_root))

from testcases.comm.base_test import BaseTest
from utils.param_util import ParamUtil
from utils.report_util import a

class <功能模块>Base(BaseTest):
    """XXX管理测试基类
    
    提供基础数据管理模块测试用例的通用功能:
    1. API 路径和参数配置加载
    2. 通用的 setup/teardown 逻辑
    3. 常用的工具方法
    """
    
    # 类变量用于存储API配置
    apis = {}
    api_params = {}
    params = {"tmodule": <模块,比如GEN_MD>}  
    @classmethod
    def setup_class(cls):
        """测试类初始化
        
        1. 调用父类初始化
        2. 加载API配置文件
        3. 加载API参数模板
        """
        super().setup_class()
        
        # 获取XXXX模块的API配置文件路径
        api_path_file = project_root / "testdata" / "gen_md" / "{}_api_path.yaml"
        api_params_file = project_root / "testdata" / "gen_md" / "{}_api_params.yaml"
        
        # 加载API配置
        cls.apis = cls.load_yaml(str(api_path_file)).get("apis")
        cls.api_params = cls.load_yaml(str(api_params_file)).get("api_params")
```

