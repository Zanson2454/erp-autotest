#### 多门户登录配置
```python
# 门户配置
portal_keys = {
    "admin": "TERP_PORTAL",
    "cust": "TERP_CUST_PC"
}
tenant_key = "terp"
login_service = LoginService(cls.env_config)

# 登录两个门户，分别保存 session/user_info/headers/url
cls.sessions = {}
cls.user_infos = {}
cls.http_clients = {}
cls.portal_urls = {}
cls.portal_headers = {}

for role, portal_key in portal_keys.items():
    result = login_service.login(portal_key=portal_key, tenant_key=tenant_key)
    if result.status != result.status.SUCCESS:
        raise RuntimeError(f"{role} 登录失败: {result.error_message}")
    portal_url = result.portal_url or ""
    if not isinstance(portal_url, str) or not portal_url:
        raise ValueError(f"{role} portal_url 不能为空且必须为字符串")
    cls.sessions[role] = result.session
    cls.user_infos[role] = result.user_info
    cls.portal_urls[role] = portal_url
    cls.portal_headers[role] = result.portal_headers
    cls.http_clients[role] = HttpUtil(
        url=portal_url,
        session=result.session,
        headers=result.portal_headers
    )

# 兼容原有写法
cls.http = cls.http_clients["admin"]
cls.http_cust = cls.http_clients["cust"]
cls.admin_session = cls.sessions["admin"]
cls.cust_session = cls.sessions["cust"]
cls.admin_user_info = cls.user_infos["admin"]
cls.cust_user_info = cls.user_infos["cust"]
```

#### 异步接口测试
```python
@case_decorator(
    story="业务故事",
    title="测试异步{功能}并等待完成",
    description="验证{具体功能}的异步执行和状态流转",
    severity="normal",
    file_level_order={序号},
    tags=["{模块}", "{功能}", "async", "wait"]
)
def test_async_{action}_{object}(self):
    """测试异步{功能}并等待完成"""
    try:
        # 1. 前置条件：确保依赖数据已存在
        if not self.{object}_id:
            self.test_save_{object}() # 假设前置创建方法

        # 2. 发起异步任务
        # 假设有一个API用于触发异步操作
        set_dict = {"id": self.{object}_id}
        response, _ = self.standard_api_call(
            api_key="{API服务名称}-异步任务发起", # 例如 "XXX-执行初始化-异步任务发起"
            set_dict=set_dict
            # fields_to_filter 可选：不传时自动从 set_dict.keys() 获取
        )
        self.assert_util.assert_response_success(response)
        
        # 可选：验证异步任务是否成功提交
        # async_status_after_trigger = response.get("data", {}).get("data", {}).get("asyncExecutionStatus")
        # self.assert_util.assert_by_operator(async_status_after_trigger, "=", "CREATED", "异步任务应为CREATED状态")

        # 3. 定义查询函数：用于轮询检查异步任务状态
        def query_{object}_status():
            """查询{对象}的当前状态"""
            # 假设有一个API用于查询异步任务的详情或状态
            query_response, _ = self.standard_api_call(
                api_key="{API服务名称}-查询详情服务", # 例如 "XXX-查询详情服务"
                set_dict={"id": self.{object}_id}
                # fields_to_filter 可选：不传时自动从 set_dict.keys() 获取
            )
            self.assert_util.assert_response_success(query_response)
            return query_response.get("data", {}).get("data", {})

        # 4. 等待异步任务完成
        result = self.async_wait_util.wait_for_async_status(
            query_func=query_{object}_status,
            status_field="asyncExecutionStatus", # 异步任务状态字段名
            success_status="SUCCEEDED",         # 成功状态值
            failed_status="FAILED",             # 失败状态值
            failure_reason_field="asyncExecutionFailureReason", # 失败原因字段名
            max_wait=60,                        # 最大等待时间（秒）
            interval=3.0                        # 轮询间隔（秒）
        )

        # 5. 断言等待结果
        if result.status == self.wait_status.SUCCESS:
            # 任务成功，进一步验证业务状态或数据
            final_async_status = result.last_data.get("asyncExecutionStatus")
            self.assert_util.assert_by_operator(
                final_async_status, "=", "SUCCEEDED",
                f"异步任务应成功完成，实际状态: {final_async_status}"
            )
            # 示例：验证业务状态字段
            # final_biz_status = result.last_data.get("bizStatus")
            # self.assert_util.assert_by_operator(final_biz_status, "=", "COMPLETED", "业务状态应为COMPLETED")
            a.text(f"✅ 异步任务成功完成，总耗时: {result.total_wait_time:.2f}秒", "异步任务结果")
        elif result.status == self.wait_status.FAILED:
            raise AssertionError(f"❌ 异步任务执行失败: {result.error_message}")
        else: # TIMEOUT or ERROR
            raise AssertionError(f"⚠️ 等待异步任务超时或检查出错: {result.error_message}")

    except Exception as e:
        a.text(str(e), "失败原因")
        raise
```

