    @classmethod
    def teardown_class(cls):
        """测试类结束后执行清理"""
        try:
            # 禁止用循环遍历表名，必须一个表一个表地单独调用
            cls.db.delete(table="{table_name}", where="{code_field} like %s", params=["AT_%"])
