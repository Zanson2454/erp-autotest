# Python Test Development Rules
# Version: 1.0.0

# 1. Project Structure
project_structure:
  <!-- - src/                    # 源代码目录 -->
  - tests/                  # 测试代码目录
    - __init__.py          # 测试包初始化文件
    - conftest.py          # pytest 配置文件
    - testcases/           # 测试用例目录
      - __init__.py
      - SCM/              # 模块测试目录
        - __init__.py
        - SO/            # 子模块测试目录
          - __init__.py
  - config/                # 配置文件目录
  - docs/                  # 文档目录
  - reports/              # 测试报告目录
  - requirements.txt    # 环境依赖
  - README.md           # 项目说明
  - .cursorrules       # 项目规则
  - .gitignore        # git忽略文件
  - .env              # 环境变量
  - .pytest.ini       # pytest 配置
  - run_test.sh       # 测试执行脚本


# 2. Code Style
code_style:
  formatter: ruff          # 使用 Ruff 进行代码格式化
  line_length: 120        # 最大行长度
  indent_size: 4          # 缩进大小
  quote_style: double     # 引号风格
  import_order: 
    - standard_library
    - third_party
    - local
  docstring_style: google # 文档字符串风格

# 3. Testing Standards
testing:
  framework: pytest       # 使用 pytest 作为测试框架
  test_naming: 
    - test_*.py          # 测试文件命名
    - test_*             # 测试函数命名
  fixtures:
    - conftest.py        # 共享 fixture
    - scope: function    # fixture 作用域
  markers:
    - smoke              # 冒烟测试
    - regression         # 回归测试
    - api               # API 测试
    - database          # 数据库测试
  coverage:
    minimum: 80          # 最小覆盖率要求
    exclude:
      - __init__.py
      - conftest.py

# 4. Documentation
documentation:
  required:
    - README.md          # 项目说明
    - CONTRIBUTING.md    # 贡献指南
    - CHANGELOG.md       # 变更日志
  docstrings:
    - classes           # 类文档
    - methods          # 方法文档
    - functions        # 函数文档
  comments:
    - complex_logic    # 复杂逻辑注释
    - todo            # TODO 注释
    - fixme           # FIXME 注释

# 5. Error Handling
error_handling:
  logging:
    - level: INFO       # 日志级别
    - format: json      # 日志格式
    - rotation: daily   # 日志轮转
  exceptions:
    - custom_exceptions # 自定义异常
    - error_codes      # 错误码
    - error_messages   # 错误消息

<!-- # 6. CI/CD
ci_cd:
  tools:
    - github_actions    # CI/CD 工具
  stages:
    - lint             # 代码检查
    - test            # 测试
    - build           # 构建
    - deploy          # 部署
  artifacts:
    - test_reports    # 测试报告
    - coverage_reports # 覆盖率报告
    - logs           # 日志文件 -->

# 7. Security
security:
  secrets:
    - env_vars        # 环境变量
    - config_files    # 配置文件
  dependencies:
    - vulnerability_scan # 依赖漏洞扫描
    - license_check    # 许可证检查

# 8. Performance
performance:
  metrics:
    - response_time   # 响应时间
    - throughput     # 吞吐量
    - error_rate     # 错误率
  benchmarks:
    - load_testing   # 负载测试
    - stress_testing # 压力测试

# 9. Code Quality
code_quality:
  static_analysis:
    - ruff           # 代码检查
    - mypy          # 类型检查
    - bandit        # 安全检查
  complexity:
    - max_cyclomatic: 10 # 最大圈复杂度
    - max_nesting: 3     # 最大嵌套层数
# 10. 要求
不要随意修改逻辑，增减请求参数的字段或调整请求参数结构
